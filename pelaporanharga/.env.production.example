APP_NAME="Lapor Harga Panen"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://api.domainanda.com

# Isi jika folder public dipisah ke document root subdomain (contoh: /home/u123456789/public_html/api)
PUBLIC_PATH=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_pelaporanharga
DB_USERNAME=u123456789_admin
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Batas masa aktif token mobile (menit). Contoh 43200 = 30 hari
SANCTUM_TOKEN_EXPIRATION=43200

# Pisahkan dengan koma jika admin atau client web lain mengakses API lewat browser
CORS_ALLOWED_ORIGINS=https://api.domainanda.com

# Wajib diisi sebelum menjalankan AdminUserSeeder di production
ADMIN_INITIAL_PASSWORD=
